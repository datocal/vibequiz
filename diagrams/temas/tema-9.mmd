        C2["2 ciclo: conocer y proteger\nacciones de conservacion"]
        C3["3 ciclo: compromisos\ny conductas sostenibles"]
        CC["Contribucion a 8 CC:\nCCL, CP, STEM, CD, CPSAA, CC, CE, CCEC"]
        DUA["DUA: Rose y Meyer 2002\nmultiples formas representacion"]
        LINEAS["Lineas de actuacion\nDec. 155/2022 Anexo II 1.4"]
